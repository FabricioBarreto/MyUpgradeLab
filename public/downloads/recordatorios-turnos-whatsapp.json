{
  "name": "Recordatorios de turno por WhatsApp — UpgradeLab",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Todos los dias a las 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "timeMin": "={{ $today.toISO() }}",
        "timeMax": "={{ $today.plus({ days: 1 }).toISO() }}",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Leer eventos de Google Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        480,
        300
      ],
      "notes": "Configurar la credencial de Google Calendar y elegir el calendario del taller antes de activar el workflow.",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Calendar del taller"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-turno-hoy",
              "leftValue": "={{ $json.start.dateTime.split('T')[0] }}",
              "rightValue": "={{ $today.toISODate() }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Filtrar turnos de hoy",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-nombre",
              "name": "nombreCliente",
              "type": "string",
              "value": "={{ $json.summary.split(' - ')[0] }}"
            },
            {
              "id": "assign-hora",
              "name": "horaTurno",
              "type": "string",
              "value": "={{ $json.start.dateTime.split('T')[1].substring(0,5) }}"
            },
            {
              "id": "assign-telefono",
              "name": "telefonoCliente",
              "type": "string",
              "value": "={{ $json.description }}"
            },
            {
              "id": "assign-mensaje",
              "name": "mensaje",
              "type": "string",
              "value": "=Hola {{ $json.summary.split(' - ')[0] }}! Te recordamos tu turno hoy a las {{ $json.start.dateTime.split('T')[1].substring(0,5) }}hs en el taller. Cualquier cosa avisanos por acá. Nos vemos!"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Armar mensaje personalizado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        300
      ],
      "notes": "Ajustar de donde salen nombreCliente/telefonoCliente segun como cargue los datos el dueño del taller en cada evento de Calendar (ej. telefono en la descripcion del evento)."
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REEMPLAZAR",
        "recipientPhoneNumber": "={{ $json.telefonoCliente }}",
        "textBody": "={{ $json.mensaje }}"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [
        1140,
        300
      ],
      "notes": "Requiere credencial de WhatsApp Business Cloud API. Si usas Twilio como intermediario en vez de la API directa de Meta, reemplazar este nodo por uno HTTP Request apuntando al endpoint de Twilio.",
      "credentials": {
        "whatsAppApi": {
          "id": "REEMPLAZAR",
          "name": "WhatsApp Business del taller"
        }
      }
    }
  ],
  "connections": {
    "Todos los dias a las 8am": {
      "main": [
        [
          {
            "node": "Leer eventos de Google Calendar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer eventos de Google Calendar": {
      "main": [
        [
          {
            "node": "Filtrar turnos de hoy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar turnos de hoy": {
      "main": [
        [
          {
            "node": "Armar mensaje personalizado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar mensaje personalizado": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Workflow de ejemplo del capitulo 04 de 'Automatizacion con IA: n8n y Make sin codigo' (UpgradeLab). Antes de activarlo: configurar las credenciales de Google Calendar y WhatsApp Business, y ajustar el nodo 'Armar mensaje personalizado' segun como esten cargados los datos en tu calendario."
  }
}
